{
  "meta": {
    "langue": "fr",
    "miseAJour": "2026-09-17",
    "source": "fanmade_listing_fr.csv — communauté arkhamhorrorfr (forum + Discord)",
    "note": "Champ `type` = type de contenu ; champ `cycle` = cycle de traduction fan-made (indépendant du type). Voir `cycles` pour le détail de chaque cycle."
  },
  "cycles": {
    "Cycle 1": {
      "description": "Huit scénarios indépendants : deux créations francophones — Face au Wendigo et Pulsions Cynégétiques — et six traductions de scénarios anglophones : The Nephew Calls, The Festival, Happy's Funhouse, Bridge of Sighs, The Pensher Wyrm, et The Limens Belief. S'y ajoutent six enquêteurs fan-made."
    },
    "Cycle 2": {
      "description": "Huit scénarios indépendants : Désolation à Bord du Constellation, La Symphonie d'Erich Zann, Les Chiens de Tindalos, Au Bord du Gouffre, Sang versé à Salem, La Couleur tombée du Ciel, L'Événement de Svalbard et L'Hôtel du Grand Chêne. S'y ajoutent des enquêteurs fan-made et les cartes joueur lauréates du concours 2020."
    },
    "Cycle 3": {
      "description": "Troisième variation sur le principe des Dossiers d'Arkham, avec cette fois trois contenus distincts totalisant huit scénarios : une campagne fan-made de quatre scénarios, Les Disparus de Killineq, une campagne fan-made de trois scénarios, Au Coeur des Ténèbres, et un scénario fan-made indépendant, La Maison Vaudou."
    },
    "Cycle 4": {
      "description": "Quatrième lot de contenu fan-made : une campagne complète de huit scénarios, Matière Noire. Contrairement aux cycles précédents, il ne porte pas le nom « Dossiers d'Arkham » puisqu'il ne rassemble qu'une seule campagne."
    },
    "Cycle 5": {
      "description": "Cinquième lot de contenu fan-made : une campagne complète de dix scénarios, Dimensions Étranges."
    },
    "Cycle 6": {
      "description": "Sixième lot de contenu fan-made : une campagne complète de huit scénarios, L'Appel du Porte Peste."
    },
    "Cycle 7": {
      "description": "Septième lot de contenu fan-made : une campagne complète de huit scénarios, Fondations Cyclopéennes."
    },
    "Cycle 8": {
      "description": "Huitième lot de contenu fan-made, regroupant plusieurs campagnes et scénarios pour un total de huit scénarios : La Guerre des Mondes, une mini-campagne de trois scénarios, La Légende du Cavalier Sans Tête, un scénario indépendant, L'Étrange Cas du Dr. Jekyll et Mr Hyde, un scénario indépendant, La Sororité des Secrets, un scénario indépendant, et De Profundis, une mini-campagne de deux scénarios."
    },
    "Cycle 9": {
      "description": "Neuvième lot de contenu fan-made : une campagne complète de huit scénarios, Alice au Pays des Merveilles."
    },
    "Cycle 10": {
      "description": "Dixième lot de contenu fan-made : une campagne complète de huit scénarios, Les Ombres de Yog Sothoth."
    },
    "Cycle 11": {
      "description": "Onzième lot de contenu fan-made, regroupant trois extensions fan-made de campagnes officielles — Renouveau Dévoreurs des Rêves, Renouveau Conspiration d'Innsmouth, et Quête Onirique Étendue, qui étend Renouveau Dévoreurs des Rêves."
    },
    "Cycle 12": {
      "description": "Douzième lot de contenu fan-made, qui rassemble deux scénarios fan-made : Noël à Arkham et Métro 2033."
    },
    "Cycle 13": {
      "description": "Treizième lot de contenu fan-made : une campagne complète de huit scénarios, La Cité de l'Invisible."
    },
    "Cycle 14": {
      "description": "Quatorzième lot de contenu fan-made : une campagne complète de huit scénarios, Circus Ex Mortis."
    },
    "Cycle 15": {
      "description": "Quinzième lot de contenu fan-made : une campagne complète de neuf scénarios, L'Ombre des Grands Anciens."
    },
    "Cycle 16": {
      "description": "Seizième lot de contenu fan-made : une campagne complète de huit scénarios, Ages Unwound."
    }
  },
