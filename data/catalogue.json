{
  "meta": {
    "langue": "fr",
    "miseAJour": "2026-11-21",
    "source": "fanmade_listing_fr.csv — communauté arkhamhorrorfr (forum + Discord)",
    "note": "Champ `type` = type de contenu ; champ `cycle` = cycle de traduction fan-made (indépendant du type). Voir `cycles` pour le détail de chaque cycle."
  },
  "cycles": {
    "Cycle 1": {
      "description": "Huit scénarios indépendants : Face au Wendigo, Jouet d'une Illusion, Le Festival, Le Palais du Rire, Le Pont des Soupirs, Le Wyrm de Pensher, Les Seuils de la Croyance et Pulsions Cynégétiques."
    },
    "Cycle 2": {
      "description": "Huit scénarios indépendants : Désolation à Bord du Constellation, La Symphonie d'Erich Zann, Les Chiens de Tindalos, Au Bord du Gouffre, Sang versé à Salem, La Couleur tombée du Ciel, L'Évènement de Svalbard et L'Hôtel du Grand Chêne."
    },
    "Cycle 3": {
      "description": "Huit scénarios en trois contenus : la campagne Les Disparus de Killineq (4 scénarios), la campagne Au Coeur des Ténèbres (3 scénarios) et le scénario indépendant La Maison Vaudou."
    },
    "Cycle 4": {
      "description": "« Matière Noire », campagne de 8 scénarios. Vous vous réveillez d'un sommeil cryogénique à bord d'un vaisseau à la dérive, en 2147, avec Neptune plein hublot. Comment et pourquoi êtes-vous ici ? Suite directe de La Route de Carcosa."
    },
    "Cycle 5": {
      "description": "« Dimensions Étranges », campagne de 10 scénarios. Votre ami Dan a disparu dans une vallée isolée aux abords de Dunwich, un coin de pays qui ne dit rien qui vaille."
    },
    "Cycle 6": {
      "description": "« L'Appel du Porte-Peste », campagne de 8 scénarios. Vous revenez à vous dans une morgue, parmi des cadavres difformes, tandis qu'un gaz verdâtre s'infiltre sous la porte."
    },
    "Cycle 7": {
      "description": "« Fondations Cyclopéennes », campagne de 8 scénarios. L'expédition de Mycènes n'est jamais rentrée et sa cargaison s'est volatilisée. Un mécène vous réclame de toute urgence."
    },
    "Cycle 8": {
      "description": "Huit scénarios aux ambiances très différentes : l'invasion martienne de La Guerre des Mondes (3 scénarios), le spectre de La Légende du Cavalier Sans Tête, le dédoublement de L'Étrange Cas du Dr. Jekyll et Mr Hyde, une soirée piégée dans La Sororité des Secrets et De Profundis (2 scénarios)."
    },
    "Cycle 9": {
      "description": "« Alice au Pays des Merveilles », campagne de 8 scénarios. Une voyageuse s'effondre en gare d'Arkham, hurlant avoir vu « l'homme habillé de journal ». Elle seule l'a vu, et l'asile pourrait en savoir plus."
    },
    "Cycle 10": {
      "description": "« Les Ombres de Yog-Sothoth », campagne de 8 scénarios. Une société fraternelle respectable d'Arkham, des dîners prestigieux et trop de disparitions parmi ses membres."
    },
    "Cycle 11": {
      "description": "Trois extensions de campagnes officielles : Renouveau Dévoreurs des Rêves, Renouveau Conspiration d'Innsmouth et Quête Onirique Étendue, qui prolonge Renouveau Dévoreurs des Rêves."
    },
    "Cycle 12": {
      "description": "Deux scénarios indépendants : Noël à Arkham et Métro 1933."
    },
    "Cycle 13": {
      "description": "« La Cité de l'Invisible », campagne de 8 scénarios."
    },
    "Cycle 14": {
      "description": "« Circus Ex Mortis », campagne de 8 scénarios. Le Cirque de la Nouvelle Lune fait halte à Arkham pour une nuit. Dans chaque ville visitée, des disparitions ont suivi, et personne ne se souvient du spectacle."
    },
    "Cycle 15": {
      "description": "« L'Ombre des Grands Anciens », campagne de 9 scénarios. Un colis anonyme contient un disque de cire dont le grésillement semble vouloir former des mots."
    },
    "Cycle 16": {
      "description": "« Ages Unwound », campagne de 8 scénarios."
    }
  },
